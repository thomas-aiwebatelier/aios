---
interface Props {
  name: string;
  description: string;
  price?: string;
  category: string;
  imageAlt: string;
  aspectRatio?: string;
}

const {
  name,
  description,
  price,
  category,
  imageAlt,
  aspectRatio = '4/3',
} = Astro.props;
---

<article class="product-card">
  <figure class="product-image img-placeholder" style={`aspect-ratio: ${aspectRatio};`} aria-label={imageAlt}>
    <!-- Foto: {imageAlt} — echte foto toe te voegen na klantgoedkeuring -->
    <span>{imageAlt}</span>
  </figure>
  <div class="product-info">
    <span class="product-category">{category}</span>
    <h3 class="product-name">{name}</h3>
    <p class="product-desc">{description}</p>
    {price && <span class="product-price">{price}</span>}
  </div>
</article>

<style>
  .product-card {
    background-color: var(--brand-bg);
    border: 1px solid color-mix(in srgb, var(--brand-primary) 12%, var(--brand-bg));
    border-radius: 4px;
    overflow: hidden;
    transition: box-shadow var(--dur-micro) var(--ease),
                border-color var(--dur-micro) var(--ease),
                transform var(--dur-micro) var(--ease);
    display: flex;
    flex-direction: column;
  }

  .product-card:hover {
    box-shadow: 0 4px 16px color-mix(in srgb, var(--brand-primary) 12%, transparent);
    border-color: var(--brand-accent);
    transform: translateY(-1px);
  }

  .product-image {
    width: 100%;
    margin: 0;
    overflow: hidden;
  }

  .product-info {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .product-category {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-accent);
  }

  .product-name {
    font-size: var(--text-lg);
    color: var(--brand-primary);
    font-family: 'Lora', Georgia, serif;
    margin: 0;
  }

  .product-desc {
    font-size: var(--text-sm);
    color: var(--brand-fg);
    opacity: 0.8;
    line-height: 1.6;
    flex: 1;
  }

  .product-price {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--brand-primary);
    font-family: 'Lora', Georgia, serif;
    margin-top: var(--space-2);
  }
</style>
