{
  "name": "aiwebatelier",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "admin:dev": "pnpm --filter admin dev",
    "agency:dev": "pnpm --filter agency-site dev",
    "db:generate": "pnpm --filter @atelier/db generate",
    "db:migrate": "pnpm --filter @atelier/db migrate",
    "build:admin": "pnpm --filter @atelier/db migrate && pnpm --filter admin build",
    "start:admin": "pnpm --filter admin start",
    "smoke": "pnpm tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "node-vibrant": "^4.0.4",
    "sharp": "^0.34.5",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@atelier/db": "workspace:^",
    "@atelier/shared": "workspace:^",
    "@playwright/test": "^1.59.1",
    "drizzle-orm": "^0.38.0",
    "googleapis": "^171.4.0",
    "gray-matter": "^4.0.3",
    "lighthouse": "^13.2.0",
    "playwright": "^1.59.1",
    "postgres": "^3.4.5",
    "puppeteer": "^25.1.0"
  },
  "pnpm": {
    "overrides": {
      "@cloudflare/workers-types": "<4.20260601.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@parcel/watcher",
      "better-sqlite3"
    ]
  }
}
