# Firebase App Hosting pnpm runtime config.
#
# Firebase's generic Node.js launcher runs `pnpm install` at every cold start.
# pnpm 11.x adds two policy checks that block the install:
#
#  1. verify-deps-before-run / minimum-release-age — supply-chain policies.
#     Mostly mitigated via root pnpm.overrides pinning of date-stamped
#     packages, but harmless to disable here too.
#
#  2. ERR_PNPM_IGNORED_BUILDS — native packages with postinstall scripts
#     (esbuild, sharp) require explicit approval. We approve them via
#     pnpm.onlyBuiltDependencies in package.json. Also disable script
#     execution at runtime entirely — node_modules in the image already
#     has the compiled binaries from build time; postinstall scripts
#     don't need to re-run.
verify-deps-before-run=false
minimum-release-age=0
ignore-scripts=true
dangerously-allow-all-builds=true
