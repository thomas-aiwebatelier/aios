# Firebase App Hosting pnpm buildpack runs `pnpm start` at container launch,
# which triggers two pnpm 11.x policy checks before the script actually runs:
#
# 1. `verify-deps-before-run` — re-verifies the lockfile matches node_modules.
# 2. `minimum-release-age` — rejects packages published in the last 24h.
#
# Both fire at runtime even though deps are baked into the image. Disabling
# them here lets `node ./dist/server/entry.mjs` start without pnpm getting
# in the way. The build itself runs the same install with these relaxed
# settings — that's fine; the SUPPLY-CHAIN trust signal is the lockfile we
# committed, not the runtime check.
verify-deps-before-run=false
minimum-release-age=0
