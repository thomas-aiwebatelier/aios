---
// Footer — three columns: agency info, links, social
// GDPR opt-out language included per spec §8
const year = new Date().getFullYear();
---
<footer class="footer" aria-label="Paginavoettekst">
  <div class="container">
    <div class="footer__grid">
      <!-- Column 1: Agency info -->
      <div class="footer__col footer__col--brand">
        <a href="/" class="footer__logo" aria-label="AI Web Atelier — homepage">
          <span class="footer__logo-text">AI Web Atelier</span>
        </a>
        <p class="footer__tagline">Vakwerk websites, gebouwd met AI</p>
        <p class="footer__location">Antwerpen, België</p>
      </div>

      <!-- Column 2: Links -->
      <nav class="footer__col" aria-label="Navigatielinks">
        <h3 class="footer__col-title">Informatie</h3>
        <ul class="footer__links">
          <li><a href="/#wat-we-doen" class="footer__link">Wat we doen</a></li>
          <li><a href="/#werkwijze" class="footer__link">Werkwijze</a></li>
          <li><a href="/#prijzen" class="footer__link">Prijzen</a></li>
          <li><a href="/#over-ons" class="footer__link">Over ons</a></li>
          <li><a href="/#contact" class="footer__link">Contact</a></li>
          <li><a href="/privacy" class="footer__link">Privacyverklaring</a></li>
          <li><a href="/terms" class="footer__link">Gebruiksvoorwaarden</a></li>
          <li>
            <a href="mailto:thomas@aiwebatelier.com" class="footer__link footer__link--email">
              thomas@aiwebatelier.com
            </a>
          </li>
        </ul>
      </nav>

      <!-- Column 3: Social + imprint -->
      <div class="footer__col">
        <h3 class="footer__col-title">Volg ons</h3>
        <ul class="footer__socials">
          <li>
            <a
              href="https://linkedin.com/in/thomas-cortebeeck"
              class="footer__social-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn profiel van Thomas Cortebeeck"
            >
              <svg class="footer__social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 6a2 2 0 1 1 0-4 2 2 0 0 1 0 4z"/>
              </svg>
              LinkedIn
            </a>
          </li>
          <li>
            <a
              href="https://github.com/thomas-cortebeeck"
              class="footer__social-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub profiel van Thomas Cortebeeck"
            >
              <svg class="footer__social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
              </svg>
              GitHub
            </a>
          </li>
        </ul>
        <div class="footer__imprint">
          <p>
            <strong>AI Web Atelier</strong><br />
            Eenmanszaak — Thomas Cortebeeck<br />
            Antwerpen, België
          </p>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <div class="footer__copyright">
        <p>© {year} AI Web Atelier — vakwerk websites, gebouwd met AI &mdash; Antwerpen, België</p>
      </div>
      <div class="footer__gdpr">
        <p>
          Wenst u uw gegevens te laten verwijderen? Antwoord met <em>'uitschrijven'</em> op een van onze mails of
          stuur een verzoek naar <a href="mailto:thomas@aiwebatelier.com">thomas@aiwebatelier.com</a>.
          Meer info in onze <a href="/privacy">privacyverklaring</a>.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-ink);
    color: rgba(255, 255, 255, 0.75);
    padding: var(--space-16) 0 var(--space-8);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: var(--space-12);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer__col-title {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: var(--space-4);
  }

  /* Brand column */
  .footer__logo {
    display: inline-block;
    margin-bottom: var(--space-4);
    text-decoration: none;
  }

  .footer__logo-text {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-white);
  }

  .footer__tagline {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.6;
    margin-bottom: var(--space-2);
  }

  .footer__location {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.4);
  }

  /* Links column */
  .footer__links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__link {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer__link:hover {
    color: var(--color-gold-light);
  }

  .footer__link--email {
    color: var(--color-gold-light);
    opacity: 0.85;
  }

  /* Social */
  .footer__socials {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer__social-link:hover {
    color: var(--color-gold-light);
  }

  .footer__social-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .footer__imprint {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.4);
    line-height: 1.6;
  }

  .footer__imprint strong {
    color: rgba(255, 255, 255, 0.6);
  }

  /* Bottom bar */
  .footer__bottom {
    padding-top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__copyright p {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.35);
  }

  .footer__gdpr p {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.35);
    line-height: 1.6;
    max-width: 720px;
  }

  .footer__gdpr a {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s;
  }

  .footer__gdpr a:hover {
    color: var(--color-gold-light);
  }

  @media (max-width: 768px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }

    .footer__col--brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
