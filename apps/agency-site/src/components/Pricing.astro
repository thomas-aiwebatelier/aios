---
// Pricing — single tier €499 per project memory override
// NOTE: €499 is the correct price (spec memory override), NOT €799 from BUILD-PROMPT.md

const included = [
  "Volledig op maat voor uw bedrijf",
  "Inclusief één herzieningsronde op basis van uw wensen",
  "Online binnen 7 dagen na uw goedkeuring",
  "Jouw domein, jouw merk, modern uitgevoerd",
  "Beveiligde HTTPS-verbinding inbegrepen",
  "SEO-basisinstellingen correct geconfigureerd",
  "Mobielvriendelijk ontwerp",
];
---
<section class="pricing" id="prijzen" aria-label="Prijzen">
  <div class="container">
    <div class="pricing__header">
      <span class="section-eyebrow">Prijzen</span>
      <h2 class="section-title">Eén eerlijke prijs.<br />Geen verrassingen.</h2>
      <p class="section-subtitle">
        Geen maandelijkse abonnementen, geen verborgen kosten. U betaalt eenmalig en uw site staat online.
      </p>
    </div>
    <div class="pricing__card-wrap">
      <article class="pricing__card" aria-label="Standaard pakket">
        <div class="pricing__badge">Meest gekozen</div>
        <div class="pricing__amount">
          <span class="pricing__currency">€</span>
          <span class="pricing__price">499</span>
          <span class="pricing__period">eenmalig</span>
        </div>
        <p class="pricing__tagline">
          Alles inbegrepen voor een professionele website die u trots presenteert.
        </p>
        <ul class="pricing__list" aria-label="Inbegrepen in het pakket">
          {included.map((item) => (
            <li class="pricing__item">
              <span class="pricing__check" aria-hidden="true">✓</span>
              {item}
            </li>
          ))}
        </ul>
        <a href="#contact" class="btn btn--primary pricing__cta">
          Vraag een voorbeeld aan
        </a>
        <p class="pricing__note">
          Geen betaling vóór u de preview heeft goedgekeurd.
        </p>
      </article>
      <div class="pricing__compare">
        <h3 class="pricing__compare-title">Vergeleken met de alternatieven</h3>
        <div class="pricing__compare-grid">
          <div class="pricing__compare-item">
            <span class="pricing__compare-label">Webbureau</span>
            <span class="pricing__compare-price">€2.000–€8.000</span>
          </div>
          <div class="pricing__compare-item">
            <span class="pricing__compare-label">Freelancer</span>
            <span class="pricing__compare-price">€1.000–€3.000</span>
          </div>
          <div class="pricing__compare-item pricing__compare-item--ours">
            <span class="pricing__compare-label">AI Web Atelier</span>
            <span class="pricing__compare-price">€499</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing {
    background: var(--color-off-white);
    padding: var(--space-24) 0;
  }

  .pricing__header {
    text-align: center;
    max-width: var(--max-width-text);
    margin: 0 auto var(--space-16);
  }

  .pricing__card-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    max-width: 900px;
    margin: 0 auto;
    align-items: start;
  }

  .pricing__card {
    background: var(--color-white);
    border: 2px solid var(--color-gold);
    border-radius: var(--radius-xl);
    padding: var(--space-10) var(--space-10);
    position: relative;
    box-shadow: var(--shadow-lg);
  }

  .pricing__badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-gold);
    color: var(--color-ink);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: var(--space-1) var(--space-4);
    border-radius: 999px;
    white-space: nowrap;
  }

  .pricing__amount {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .pricing__currency {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--color-gold-dark);
  }

  .pricing__price {
    font-family: var(--font-serif);
    font-size: var(--text-7xl);
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1;
  }

  .pricing__period {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    font-weight: 500;
  }

  .pricing__tagline {
    font-size: var(--text-base);
    color: var(--color-ink-soft);
    line-height: 1.6;
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .pricing__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .pricing__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    line-height: 1.5;
  }

  .pricing__check {
    color: var(--color-gold-dark);
    font-size: var(--text-base);
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .pricing__cta {
    width: 100%;
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .pricing__note {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    text-align: center;
    line-height: 1.5;
  }

  /* Buttons (duplicated from Hero so section is self-contained) */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.15s;
    text-decoration: none;
    border: 2px solid transparent;
  }

  .btn--primary {
    background: var(--color-gold);
    color: var(--color-ink);
    border-color: var(--color-gold);
  }

  .btn--primary:hover {
    background: var(--color-gold-dark);
    border-color: var(--color-gold-dark);
    transform: translateY(-1px);
  }

  /* Compare box */
  .pricing__compare {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
  }

  .pricing__compare-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: var(--space-6);
    line-height: 1.3;
  }

  .pricing__compare-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .pricing__compare-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-off-white);
  }

  .pricing__compare-item--ours {
    background: rgba(201, 169, 110, 0.12);
    border: 1px solid var(--color-gold-light);
  }

  .pricing__compare-item--ours .pricing__compare-label {
    font-weight: 700;
    color: var(--color-ink);
  }

  .pricing__compare-item--ours .pricing__compare-price {
    color: var(--color-gold-dark);
    font-weight: 700;
  }

  .pricing__compare-label {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .pricing__compare-price {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .pricing__card-wrap {
      grid-template-columns: 1fr;
      max-width: 480px;
    }
  }
</style>
