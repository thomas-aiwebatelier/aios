---
// Pricing — two-tier per project memory v2:
//   €499 one-time build (incl. 1 iteration after MVP)
//   €9.99/month OPTIONAL maintenance + hosting (cancellable, full code ownership stays with client)

const buildIncludes = [
  "Volledig op maat — geen sjabloon",
  "Eerste versie binnen 7 dagen na akkoord",
  "Eén iteratieronde na uw review — daarna is de site af",
  "Volledig eigendom van code en inhoud",
  "Snel + mobielvriendelijk + SEO-basis correct",
];

const maintenanceIncludes = [
  "Hosting op Cloudflare (snel, wereldwijd CDN)",
  "SSL-certificaat automatisch verlengd",
  "Beveiligings- en software-updates",
  "Uptime monitoring 24/7",
  "Tot 1 kleine inhoudswijziging per maand",
  "E-mailsupport binnen 24 uur",
];
---
<section class="pricing" id="prijzen" aria-label="Prijzen">
  <div class="container">
    <div class="pricing__header">
      <span class="section-eyebrow">Prijzen</span>
      <h2 class="section-title">Eén keer bouwen.<br /><span class="pricing__title-accent">Voor altijd zorgeloos.</span></h2>
      <p class="section-subtitle">
        U betaalt eenmalig voor de bouw, plus optioneel een vast bedrag per maand voor hosting en onderhoud.
        Geen verrassingen, geen contractduur. Opzegbaar per maand.
      </p>
    </div>

    <div class="pricing__cards">
      <!-- Tier 1: One-time build -->
      <article class="pricing__card pricing__card--build" aria-label="Eenmalige bouw">
        <div class="pricing__badge">Stap 1 · de bouw</div>
        <div class="pricing__amount">
          <span class="pricing__currency">€</span>
          <span class="pricing__price">499</span>
          <span class="pricing__period">eenmalig</span>
        </div>
        <p class="pricing__tagline">
          Wij bouwen een eerste versie op basis van research + uw merk.
          U geeft feedback. Wij doen één iteratie. <strong>Klaar.</strong>
        </p>
        <ul class="pricing__list" aria-label="Inbegrepen bij de bouw">
          {buildIncludes.map((item) => (
            <li class="pricing__item">
              <span class="pricing__check" aria-hidden="true">✓</span>
              {item}
            </li>
          ))}
        </ul>
        <a href="#contact" class="btn btn--primary pricing__cta">
          Vraag jouw voorbeeld aan
        </a>
        <p class="pricing__note">
          U betaalt pas wanneer u de eerste versie heeft goedgekeurd.
        </p>
      </article>

      <!-- Tier 2: Optional monthly maintenance -->
      <article class="pricing__card pricing__card--maintain" aria-label="Onderhoud en hosting (optioneel)">
        <div class="pricing__badge pricing__badge--secondary">Stap 2 · zorgeloos online blijven</div>
        <div class="pricing__amount">
          <span class="pricing__currency">€</span>
          <span class="pricing__price">9,99</span>
          <span class="pricing__period">/maand · optioneel</span>
        </div>
        <p class="pricing__tagline">
          Wij houden uw site snel, veilig en bereikbaar — zodat u zich kan
          focussen op uw zaak. Of hosten zelf — u bezit de volledige code.
        </p>
        <ul class="pricing__list" aria-label="Inbegrepen in onderhoud en hosting">
          {maintenanceIncludes.map((item) => (
            <li class="pricing__item">
              <span class="pricing__check" aria-hidden="true">✓</span>
              {item}
            </li>
          ))}
        </ul>
        <a href="#contact" class="btn btn--ghost pricing__cta">
          Meer info
        </a>
        <p class="pricing__note">
          Opzegbaar per maand. U behoudt altijd het eigendom van de code.
        </p>
      </article>
    </div>

    <!-- Total cost reframe -->
    <div class="pricing__total">
      <div class="pricing__total-line">
        <span class="pricing__total-label">Eerste jaar, alles inbegrepen:</span>
        <span class="pricing__total-value">€499 + €119,88 = <strong>€618,88</strong></span>
      </div>
      <p class="pricing__total-note">
        Of zonder onderhoud: gewoon €499 eenmalig en u host het zelf.
      </p>
    </div>

    <!-- Compare to alternatives -->
    <div class="pricing__compare">
      <h3 class="pricing__compare-title">Wat anderen vragen voor een vergelijkbare website</h3>
      <div class="pricing__compare-grid">
        <div class="pricing__compare-item">
          <span class="pricing__compare-label">Webbureau (op maat)</span>
          <span class="pricing__compare-price">€2.000–€8.000 + €40–€100/mnd</span>
        </div>
        <div class="pricing__compare-item">
          <span class="pricing__compare-label">Freelancer</span>
          <span class="pricing__compare-price">€1.000–€3.000 + losse facturen</span>
        </div>
        <div class="pricing__compare-item pricing__compare-item--ours">
          <span class="pricing__compare-label">AI Web Atelier</span>
          <span class="pricing__compare-price">€499 + €9,99/mnd</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing {
    background: var(--color-off-white);
    padding: var(--space-24) 0;
  }

  .pricing__header {
    text-align: center;
    max-width: var(--max-width-text);
    margin: 0 auto var(--space-16);
  }

  .pricing__title-accent {
    color: var(--color-gold-dark);
  }

  .pricing__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    max-width: 980px;
    margin: 0 auto;
    align-items: start;
  }

  .pricing__card {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    padding: var(--space-10);
    position: relative;
    box-shadow: var(--shadow-lg);
  }

  .pricing__card--build {
    border: 2px solid var(--color-gold);
  }

  .pricing__card--maintain {
    border: 1px solid var(--color-border);
  }

  .pricing__badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-gold);
    color: var(--color-ink);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: var(--space-1) var(--space-4);
    border-radius: 999px;
    white-space: nowrap;
  }

  .pricing__badge--secondary {
    background: var(--color-ink);
    color: var(--color-cream);
  }

  .pricing__amount {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    margin-top: var(--space-4);
  }

  .pricing__currency {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--color-gold-dark);
  }

  .pricing__price {
    font-family: var(--font-serif);
    font-size: var(--text-7xl);
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1;
  }

  .pricing__card--maintain .pricing__price {
    font-size: var(--text-6xl);
  }

  .pricing__period {
    font-size: var(--text-base);
    color: var(--color-ink-muted);
    font-weight: 500;
  }

  .pricing__tagline {
    font-size: var(--text-base);
    color: var(--color-ink-soft);
    line-height: 1.6;
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .pricing__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .pricing__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    line-height: 1.5;
  }

  .pricing__check {
    color: var(--color-gold-dark);
    font-size: var(--text-base);
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .pricing__cta {
    width: 100%;
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .pricing__note {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    text-align: center;
    line-height: 1.5;
  }

  /* Total cost reframe */
  .pricing__total {
    max-width: 720px;
    margin: var(--space-16) auto var(--space-12);
    padding: var(--space-8) var(--space-10);
    background: var(--color-white);
    border-left: 4px solid var(--color-gold);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .pricing__total-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-6);
    flex-wrap: wrap;
    font-family: var(--font-sans);
    font-size: var(--text-base);
  }

  .pricing__total-label {
    color: var(--color-ink-soft);
  }

  .pricing__total-value {
    color: var(--color-ink);
    font-size: var(--text-lg);
  }

  .pricing__total-value strong {
    color: var(--color-gold-dark);
  }

  .pricing__total-note {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.15s;
    text-decoration: none;
    border: 2px solid transparent;
  }

  .btn--primary {
    background: var(--color-gold);
    color: var(--color-ink);
    border-color: var(--color-gold);
  }

  .btn--primary:hover {
    background: var(--color-gold-dark);
    border-color: var(--color-gold-dark);
    transform: translateY(-1px);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-ink);
    border-color: var(--color-border);
  }

  .btn--ghost:hover {
    border-color: var(--color-ink);
    transform: translateY(-1px);
  }

  /* Compare box */
  .pricing__compare {
    max-width: 720px;
    margin: 0 auto;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
  }

  .pricing__compare-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: var(--space-6);
    line-height: 1.3;
    text-align: center;
  }

  .pricing__compare-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .pricing__compare-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-off-white);
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .pricing__compare-item--ours {
    background: rgba(201, 169, 110, 0.12);
    border: 1px solid var(--color-gold-light);
  }

  .pricing__compare-item--ours .pricing__compare-label {
    font-weight: 700;
    color: var(--color-ink);
  }

  .pricing__compare-item--ours .pricing__compare-price {
    color: var(--color-gold-dark);
    font-weight: 700;
  }

  .pricing__compare-label {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .pricing__compare-price {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .pricing__cards {
      grid-template-columns: 1fr;
      max-width: 480px;
      gap: var(--space-12);
    }

    .pricing__total-line {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
</parameter>
</invoke>