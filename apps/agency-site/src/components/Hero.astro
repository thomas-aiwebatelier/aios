---
// Hero section — full-bleed with conic-gradient mesh background
// CSS fade-up animation on title + tagline (prefers-reduced-motion safe)
---
<section class="hero" aria-label="Introductie">
  <div class="hero__mesh" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow">AI Web Atelier</p>
      <h1 class="hero__title">
        Vakwerk websites,<br />
        <span class="hero__title--accent">gebouwd met AI</span>
      </h1>
      <p class="hero__tagline">
        Custom AI-gegenereerde websites voor Belgische ondernemers —
        <strong>€499 eenmalig, inclusief één herziening</strong>
        op basis van uw wensen
      </p>
      <div class="hero__ctas">
        <a href="#contact" class="btn btn--primary">Vraag jouw voorbeeld aan</a>
        <a href="#wat-we-doen" class="btn btn--ghost">Hoe het werkt</a>
      </div>
    </div>
    <div class="hero__visual" aria-hidden="true">
      <div class="hero__card">
        <div class="hero__card-badge">€499</div>
        <div class="hero__card-lines">
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="hero__card-footer">Online binnen 7 dagen</div>
      </div>
    </div>
  </div>
  <div class="hero__scroll-hint" aria-hidden="true">
    <span class="hero__scroll-line"></span>
    <span class="hero__scroll-label">scroll</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--color-cream);
  }

  .hero__mesh {
    position: absolute;
    inset: 0;
    background:
      conic-gradient(
        from 200deg at 70% 40%,
        transparent 0deg,
        rgba(201, 169, 110, 0.08) 60deg,
        transparent 120deg
      ),
      conic-gradient(
        from 20deg at 20% 70%,
        transparent 0deg,
        rgba(201, 169, 110, 0.06) 80deg,
        transparent 160deg
      ),
      radial-gradient(ellipse 80% 60% at 65% 45%, rgba(201, 169, 110, 0.10) 0%, transparent 70%),
      radial-gradient(ellipse 50% 80% at 10% 80%, rgba(244, 243, 238, 0.8) 0%, transparent 60%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
  }

  .hero__content {
    animation: fade-up 0.6s ease-out both;
  }

  .hero__eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: var(--space-4);
  }

  .hero__title {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-4xl), 5vw, var(--text-7xl));
    font-weight: 700;
    line-height: 1.05;
    color: var(--color-ink);
    margin-bottom: var(--space-6);
  }

  .hero__title--accent {
    color: var(--color-gold-dark);
  }

  .hero__tagline {
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
    line-height: 1.7;
    max-width: 520px;
    margin-bottom: var(--space-10);
    animation: fade-up 0.6s 0.2s ease-out both;
  }

  .hero__ctas {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    animation: fade-up 0.6s 0.35s ease-out both;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.15s;
    text-decoration: none;
    border: 2px solid transparent;
  }

  .btn--primary {
    background: var(--color-gold);
    color: var(--color-ink);
    border-color: var(--color-gold);
  }

  .btn--primary:hover {
    background: var(--color-gold-dark);
    border-color: var(--color-gold-dark);
    transform: translateY(-1px);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-ink);
    border-color: var(--color-border);
  }

  .btn--ghost:hover {
    border-color: var(--color-ink);
    transform: translateY(-1px);
  }

  /* Decorative card */
  .hero__visual {
    display: flex;
    justify-content: center;
    animation: fade-in 0.8s 0.4s ease-out both;
  }

  .hero__card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-10) var(--space-8);
    box-shadow: var(--shadow-lg);
    width: 100%;
    max-width: 340px;
    position: relative;
  }

  .hero__card-badge {
    font-family: var(--font-serif);
    font-size: var(--text-5xl);
    font-weight: 700;
    color: var(--color-gold-dark);
    margin-bottom: var(--space-8);
    line-height: 1;
  }

  .hero__card-lines {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .hero__card-lines span {
    height: 10px;
    border-radius: 5px;
    background: var(--color-border-light);
    display: block;
  }

  .hero__card-lines span:nth-child(1) { width: 80%; }
  .hero__card-lines span:nth-child(2) { width: 65%; }
  .hero__card-lines span:nth-child(3) { width: 75%; }
  .hero__card-lines span:nth-child(4) { width: 50%; }

  .hero__card-footer {
    font-size: var(--text-sm);
    color: var(--color-gold-dark);
    font-weight: 600;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  /* Scroll hint */
  .hero__scroll-hint {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    animation: fade-in 1s 0.8s ease-out both;
  }

  .hero__scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--color-gold), transparent);
    animation: scroll-line 1.5s 1s ease-in-out infinite;
  }

  .hero__scroll-label {
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  @keyframes scroll-line {
    0%, 100% { opacity: 0.4; transform: scaleY(0.8); }
    50% { opacity: 1; transform: scaleY(1); }
  }

  @media (max-width: 768px) {
    .hero__inner {
      grid-template-columns: 1fr;
      padding-top: var(--space-20);
      padding-bottom: var(--space-16);
    }

    .hero__visual {
      display: none;
    }

    .hero__title {
      font-size: clamp(var(--text-3xl), 8vw, var(--text-5xl));
    }
  }
</style>
