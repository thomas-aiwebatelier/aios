---
// Process timeline — CSS scroll-driven animations
// Uses animation-timeline: view() for items fading in as they enter viewport.
// Graceful fallback: if browser doesn't support scroll-driven animations, items
// display statically (no JS required, no layout shift).

const steps = [
  {
    phase: "01",
    label: "Research",
    title: "We luisteren eerst",
    body: "U vertelt ons over uw bedrijf, uw doelgroep en uw concurrenten. We stellen gerichte vragen en analyseren uw markt. Dit duurt één gesprek van 30 minuten — u hoeft niets voor te bereiden.",
    duration: "Dag 1",
  },
  {
    phase: "02",
    label: "Generate",
    title: "AI doet het zware werk",
    body: "Ons AI-systeem genereert op basis van uw input de volledige websitestructuur, teksten en opmaak. We sturen meerdere varianten en kiezen samen de beste richting.",
    duration: "Dag 2–3",
  },
  {
    phase: "03",
    label: "Review",
    title: "U keurt goed (of niet)",
    body: "U bekijkt een live preview van uw site. U mag één herziening aanvragen — aanpassingen aan inhoud, stijl of structuur. We voeren ze uit zonder meerprijs.",
    duration: "Dag 4–5",
  },
  {
    phase: "04",
    label: "Launch",
    title: "Live op uw domein",
    body: "We publiceren uw website op uw eigen domein. Inclusief beveiligde verbinding (HTTPS), correcte SEO-instellingen en snelle laadtijden. U lanceert met vertrouwen.",
    duration: "Dag 6–7",
  },
];
---
<section class="process" id="werkwijze" aria-label="Onze werkwijze">
  <div class="container">
    <div class="process__header">
      <span class="section-eyebrow">Onze werkwijze</span>
      <h2 class="section-title">Van gesprek tot live<br />in 7 dagen</h2>
    </div>
    <div class="process__timeline" role="list">
      {steps.map((step, i) => (
        <div class="process__item" role="listitem" style={`--i: ${i};`}>
          <div class="process__left">
            <div class="process__phase">{step.phase}</div>
            <div class="process__connector" aria-hidden="true"></div>
          </div>
          <div class="process__right">
            <div class="process__meta">
              <span class="process__label">{step.label}</span>
              <span class="process__duration">{step.duration}</span>
            </div>
            <h3 class="process__title">{step.title}</h3>
            <p class="process__body">{step.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process {
    background: var(--color-cream);
    padding: var(--space-24) 0;
  }

  .process__header {
    text-align: center;
    max-width: var(--max-width-text);
    margin: 0 auto var(--space-16);
  }

  .process__timeline {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .process__item {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-8);
    padding-bottom: var(--space-12);

    /* CSS scroll-driven animation — fade + slide up as item enters viewport */
    animation: fade-up 0.5s ease-out both;
    animation-timeline: view();
    animation-range: entry 0% entry 40%;
  }

  /* Fallback for browsers without scroll-driven animation support */
  @supports not (animation-timeline: view()) {
    .process__item {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  .process__left {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .process__phase {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-gold);
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 0 0 4px var(--color-gold-light);
  }

  .process__connector {
    flex: 1;
    width: 2px;
    background: linear-gradient(to bottom, var(--color-gold-light), transparent);
    margin-top: var(--space-3);
  }

  .process__item:last-child .process__connector {
    display: none;
  }

  .process__right {
    padding-top: var(--space-2);
  }

  .process__meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .process__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold-dark);
  }

  .process__duration {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    background: var(--color-off-white);
    padding: 2px var(--space-3);
    border-radius: 999px;
    border: 1px solid var(--color-border);
  }

  .process__title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: var(--space-3);
    line-height: 1.25;
  }

  .process__body {
    font-size: var(--text-base);
    color: var(--color-ink-soft);
    line-height: 1.75;
  }

  @media (max-width: 600px) {
    .process__item {
      grid-template-columns: 56px 1fr;
      gap: var(--space-4);
    }

    .process__phase {
      width: 44px;
      height: 44px;
      font-size: var(--text-base);
    }
  }
</style>
