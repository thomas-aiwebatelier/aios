---
export const prerender = false;

import Base from "../../layouts/Base.astro";
import { getDb } from "../../lib/db";
import { blogPosts } from "@atelier/db";
import { and, eq } from "drizzle-orm";
import { marked } from "marked";

const { slug } = Astro.params;
if (!slug) return new Response(null, { status: 404 });

const runtimeEnv = (Astro.locals as any)?.runtime?.env as
  | Record<string, unknown>
  | undefined;
const db = getDb(runtimeEnv);

const [post] = await db
  .select()
  .from(blogPosts)
  .where(and(eq(blogPosts.slug, slug), eq(blogPosts.status, "published")))
  .limit(1);

if (!post) return new Response(null, { status: 404 });

// Rewrite `.excalidraw` refs to served SVG paths.
const markdown = post.bodyMarkdown.replace(
  /!\[([^\]]*)\]\(\.\/diagrams\/([^)]+)\.excalidraw\)/g,
  (_m, alt, name) => `![${alt}](/blog/diagrams/${name}.svg)`
);

const html = marked.parse(markdown);

const dateFormatter = new Intl.DateTimeFormat("nl-BE", {
  year: "numeric", month: "long", day: "numeric",
});
---

<Base
  title={post.seoTitle ?? post.title}
  description={post.seoDescription ?? post.excerpt ?? undefined}
>
  <article class="blog-post">
    <header class="blog-post-header">
      <p class="back"><a href="/blog">← terug naar alle posts</a></p>
      <h1>{post.title}</h1>
      <div class="post-meta">
        {post.publishedAt && (
          <time datetime={post.publishedAt.toISOString()}>
            {dateFormatter.format(post.publishedAt)}
          </time>
        )}
        {post.attributionName && post.attributionUrl && (
          <p class="attribution">
            Framework <em>{post.attributionFramework}</em> door{" "}
            <a href={post.attributionUrl} target="_blank" rel="noopener">{post.attributionName}</a>
          </p>
        )}
      </div>
    </header>
    <div class="blog-post-body" set:html={html} />
  </article>
</Base>

<style is:global>
  .blog-post { max-width: 760px; margin: 0 auto; padding: 4rem 1.5rem; }
  .blog-post-header { margin-bottom: 3rem; }
  .blog-post-header .back { margin: 0 0 1.5rem; font-size: 0.9rem; }
  .blog-post-header h1 { font-size: 2.5rem; margin: 0 0 1rem; line-height: 1.15; }
  .post-meta { color: var(--muted, #6b7280); font-size: 0.9rem; }
  .post-meta time { display: block; margin-bottom: 0.5rem; }
  .post-meta .attribution { margin: 0; }
  .blog-post-body { font-size: 1.05rem; line-height: 1.7; color: var(--ink, #1f2937); }
  .blog-post-body h2 { font-size: 1.6rem; margin: 3rem 0 1rem; }
  .blog-post-body p { margin: 0 0 1.25rem; }
  .blog-post-body img { max-width: 100%; height: auto; margin: 2rem 0; border: 1px solid var(--border, #e5e7eb); border-radius: 0.5rem; padding: 1rem; background: #fff; }
  .blog-post-body code { background: rgba(0,0,0,0.05); padding: 0.1em 0.35em; border-radius: 4px; font-size: 0.92em; }
  .blog-post-body table { border-collapse: collapse; margin: 2rem 0; font-size: 0.95rem; }
  .blog-post-body th, .blog-post-body td { padding: 0.5rem 0.75rem; border: 1px solid var(--border, #e5e7eb); text-align: left; }
  .blog-post-body th { background: rgba(0,0,0,0.03); font-weight: 600; }
</style>
