{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    // DOM is here only because the skills/atelier-design-system/quality-checks.ts
    // file we depend on uses DOMParser-style types. We don't actually run in the
    // browser — this is a pure Node daemon.
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@atelier/*": ["../../packages/*/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist", "data"]
}
