{
  "name": "local-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Windows daemon: polls Postgres for research+generation+deploy jobs, runs claude CLI + wrangler + Playwright subprocesses on the operator's machine (keeps Thomas's Claude Code Max plan in the loop).",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atelier/db": "workspace:^",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.38.0",
    "nanoid": "^5.1.11",
    "node-vibrant": "^4.0.4",
    "playwright": "^1.59.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
